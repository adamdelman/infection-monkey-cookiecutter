[general]
# body-requires-pr-number decides which commits need a body; "PR #123" alone is enough
ignore=body-min-length,body-is-missing
# Merges into master/main/dev need a PR number too (see commit_hooks/add_pr_number.py)
ignore-merge-commits=false
extra-path=commit_hooks/gitlint_rules.py
regex-style-search=true

[title-match-regex]
regex=^[A-Z][A-Z0-9_]+-\d+: [A-Z]

[body-max-line-length]
line-length=72

[ignore-body-lines]
# A URL or a Co-authored-by trailer stops working if it is wrapped
regex=(?i)^(\s*https?://\S+\s*|co-authored-by: .*)$

[ignore-by-title]
# git writes merge titles, so only the body is checked. A hook such as jira-issue-commit-hook
# may have added a Jira key in front.
regex=^([A-Z][A-Z0-9_]+-\d+: )?Merge (remote-tracking branch|branch|tag) '
# Replaces the [general] ignore list for these commits, so those rules are listed again
ignore=title-match-regex,title-imperative-mood,title-max-length,body-min-length,body-is-missing

[ignore-by-title:prefixed-skips]
# gitlint skips fixup!, squash!, amend! and revert commits, but not once a Jira key is in front
regex=^[A-Z][A-Z0-9_]+-\d+: ((fixup|squash|amend)! |Revert ")
ignore=all
